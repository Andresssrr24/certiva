{
  "name": "certiva",
  "version": "0.1.0",
  "private": true,
  "description": "Certiva · Tu aliado contra el fraude. Verificación local con QVAC.",
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
