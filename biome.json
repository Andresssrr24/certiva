{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!data/html",
      "!data/capturas",
      "!docs",
      "!eval/*.json",
      "!eval/*.jsonl",
      "!vendor-notice",
      "!eval/runs",
      "!mobile/app",
      "!**/*.svg",
      "!pilot/**/certiva.js",
      "!pilot/**/policy.json",
      "!pilot/public/policy-key.js",
      "!pilot/android-qvac/evidence",
      "!pilot/ios/**/*.xcassets"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noControlCharactersInRegex": "off"
      },
      "complexity": {
        "useLiteralKeys": "off"
      },
      "style": {
        "useTemplate": "off",
        "noUselessElse": "off"
      },
      "a11y": {
        "useMediaCaption": "off"
      }
    }
  }
}
